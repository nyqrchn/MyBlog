---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getAllTags, getPublishedPosts, postUrl } from '../../lib/blog';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`Tag: ${tag}`} description={`${tag} タグの記事一覧です。`}>
  <main class="page-shell narrow">
    <section class="page-heading">
      <p class="eyebrow">Tag</p>
      <h1>{tag}</h1>
    </section>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-card">
            <p class="meta">{formatDate(post.data.publishedAt)}</p>
            <h2>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
