---
import ReviewArchive from '../components/ReviewArchive';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postUrl } from '../lib/records';
import { site } from '../lib/site';

const posts = await getPublishedPosts();
const reviews = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  url: postUrl(post),
  date: formatDate(post.data.publishedAt),
  tags: post.data.tags,
  category: post.data.category,
  creator: post.data.creator,
  workYear: post.data.workYear,
  rating: post.data.rating,
  cover: post.data.cover,
}));
---

<BaseLayout
  title={site.name}
  description={site.description}
>
  <ReviewArchive client:load reviews={reviews} />
</BaseLayout>
