---
import ReviewArchive from '../components/ReviewArchive';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postUrl } from '../lib/blog';

const posts = await getPublishedPosts();
const reviews = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  url: postUrl(post),
  date: formatDate(post.data.publishedAt),
  tags: post.data.tags,
  category: post.data.category,
  creator: post.data.creator,
  workYear: post.data.workYear,
  rating: post.data.rating,
  cover: post.data.cover,
}));
---

<BaseLayout
  title="キロクレコード"
  description="本、映画、音楽作品のレビューと感想を集める個人アーカイブです。"
  showHeader={false}
>
  <ReviewArchive client:load reviews={reviews} />
</BaseLayout>
