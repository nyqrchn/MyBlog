---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postUrl } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Articles" description="公開済みの記事一覧です。">
  <main class="page-shell narrow">
    <section class="page-heading">
      <p class="eyebrow">Articles</p>
      <h1>記事一覧</h1>
    </section>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-card">
            <p class="meta">{formatDate(post.data.publishedAt)}</p>
            <h2>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
            <p class="creator">{post.data.creator}{post.data.workYear ? ` / ${post.data.workYear}` : ''}</p>
            {
              post.data.rating && (
                <p class="rating" aria-label={`評価 ${post.data.rating.toFixed(1)} / 5`}>
                  <span class="stars" style={`--rating: ${Math.max(0, Math.min(100, (post.data.rating / 5) * 100))}%`} aria-hidden="true">
                    <span class="stars-base">★★★★★</span>
                    <span class="stars-fill">★★★★★</span>
                  </span>
                  <span>{post.data.rating.toFixed(1)}</span>
                </p>
              )
            }
            <p>{post.data.description}</p>
            <div class="inline-tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
